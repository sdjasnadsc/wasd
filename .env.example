# Node 24 or newer. These defaults work without copying this file.
HOST=0.0.0.0
PORT=5173

# Defaults to data/abyssal.sqlite under the project root.
# DATABASE_PATH=/absolute/path/to/abyssal.sqlite

# Use both settings behind a trusted TLS-terminating reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=0

# Optional. Set a random value of at least 24 characters to enable /admin.
# ADMIN_TOKEN=
