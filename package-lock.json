{
  "name": "abyssal-trivia",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "abyssal-trivia",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "dependencies": {
        "http-parser-js": "file:vendor/http-parser-js",
        "safe-buffer": "file:vendor/safe-buffer",
        "websocket-driver": "file:vendor/websocket-driver",
        "websocket-extensions": "file:vendor/websocket-extensions"
      },
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "apps/server": {
      "name": "@abyssal/server",
      "version": "1.0.0",
      "dependencies": {
        "@abyssal/shared": "*"
      }
    },
    "apps/web": {
      "name": "@abyssal/web",
      "version": "1.0.0"
    },
    "node_modules/@abyssal/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@abyssal/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@abyssal/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/http-parser-js": {
      "resolved": "vendor/http-parser-js",
      "link": true
    },
    "node_modules/safe-buffer": {
      "resolved": "vendor/safe-buffer",
      "link": true
    },
    "node_modules/websocket-driver": {
      "resolved": "vendor/websocket-driver",
      "link": true
    },
    "node_modules/websocket-extensions": {
      "resolved": "vendor/websocket-extensions",
      "link": true
    },
    "packages/shared": {
      "name": "@abyssal/shared",
      "version": "1.0.0"
    },
    "vendor/http-parser-js": {
      "version": "0.5.10",
      "license": "MIT"
    },
    "vendor/safe-buffer": {
      "version": "5.1.2",
      "license": "MIT"
    },
    "vendor/websocket-driver": {
      "version": "0.7.5",
      "license": "Apache-2.0",
      "dependencies": {
        "http-parser-js": "file:../http-parser-js",
        "safe-buffer": "file:../safe-buffer",
        "websocket-extensions": "file:../websocket-extensions"
      },
      "engines": {
        "node": ">=0.8.0"
      }
    },
    "vendor/websocket-extensions": {
      "version": "0.1.4",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=0.8.0"
      }
    }
  }
}
