{
  "name": "Reef Relay",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "postStartCommand": "bash .devcontainer/start-game.sh",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Reef Relay",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "COOKIE_SECURE": "true"
  }
}
